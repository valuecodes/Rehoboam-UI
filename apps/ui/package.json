{
  "name": "rehoboam-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite preview --port 3000",
    "build": "vite build",
    "deploy": "wrangler pages deploy dist --project-name=rehoboam-ui",
    "bundle:analyze": "analyze",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test --project=smoke",
    "e2e:ui": "playwright test --project=smoke --ui",
    "e2e:api": "playwright test --project=api-contract",
    "e2e:all": "playwright test --project=smoke --project=api-contract",
    "e2e:install": "playwright install --with-deps chromium",
    "screenshot:scene": "node --experimental-strip-types scripts/screenshot-scene.ts",
    "screenshot:scene:headed": "node --experimental-strip-types scripts/screenshot-scene.ts --headed",
    "clean": "rm -rf .turbo node_modules .cache dist"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "catalog:",
    "@repo/types": "workspace:*",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@repo/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zx": "catalog:"
  }
}

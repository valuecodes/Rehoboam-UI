{
  "name": "rehoboam-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite preview --port 3000",
    "build": "vite build",
    "bundle:analyze": "analyze",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test --project=smoke",
    "e2e:ui": "playwright test --project=smoke --ui",
    "e2e:api": "playwright test --project=api-contract",
    "e2e:all": "playwright test --project=smoke --project=api-contract",
    "e2e:install": "playwright install --with-deps chromium",
    "screenshot:scene": "node --experimental-strip-types scripts/screenshot-scene.ts",
    "screenshot:scene:headed": "node --experimental-strip-types scripts/screenshot-scene.ts --headed"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.8",
    "@repo/types": "workspace:*",
    "motion": "12.34.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@repo/eslint": "workspace:*",
    "@repo/prettier": "workspace:*",
    "@repo/typescript": "workspace:*",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.3",
    "eslint": "9.39.1",
    "jsdom": "28.1.0",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-bundle-analyzer": "1.3.6",
    "vitest": "4.0.18",
    "zx": "8.8.5"
  },
  "prettier": "@repo/prettier"
}

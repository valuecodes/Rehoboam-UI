{
  "name": "rehoboam-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 3001 --persist-to ../../packages/db/.wrangler/state",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc",
    "postinstall": "wrangler types",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo node_modules .cache"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/service-worker-mock": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}

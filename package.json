{
  "name": "rehoboam-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "clean": "turbo run clean",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config --local core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:"
  }
}

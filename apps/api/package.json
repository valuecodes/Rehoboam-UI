{
  "name": "rehoboam-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 3001 --persist-to ../../packages/db/.wrangler/state",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "wrangler types",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.6",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "4.12.27",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint": "workspace:*",
    "@repo/prettier": "workspace:*",
    "@repo/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/service-worker-mock": "catalog:",
    "eslint": "9.39.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "prettier": "@repo/prettier"
}

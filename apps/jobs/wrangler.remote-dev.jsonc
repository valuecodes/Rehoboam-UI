/**
 * Local development config for real Workers AI with a small AI processing cap.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rehoboam-jobs-remote-dev",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "AI_ITEM_LIMIT": "3",
  },
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rehoboam-jobs-db",
      "database_id": "0a4c36ee-f8ef-415e-ae45-6b985510fad4",
      "migrations_dir": "drizzle",
    },
  ],
  "triggers": {
    "crons": ["0 9 * * *"],
  },
}

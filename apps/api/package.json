{
  "name": "rehoboam-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 3001 --persist-to ../../packages/db/.wrangler/state",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "wrangler types",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.6",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/types": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/eslint": "workspace:*",
    "@repo/prettier": "workspace:*",
    "@repo/typescript": "workspace:*",
    "@types/node": "25.6.0",
    "@types/service-worker-mock": "2.0.4",
    "eslint": "9.39.1",
    "prettier": "3.8.2",
    "typescript": "6.0.2",
    "vitest": "4.1.4",
    "wrangler": "4.81.1"
  },
  "prettier": "@repo/prettier"
}

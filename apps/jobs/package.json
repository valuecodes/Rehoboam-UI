{
  "name": "rehoboam-jobs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --config wrangler.local.jsonc --port 3002 --inspector-port 9230 --persist-to ../../packages/db/.wrangler/state --test-scheduled",
    "dev:remote": "wrangler dev --config wrangler.remote-dev.jsonc --port 3002 --inspector-port 9230 --persist-to ../../packages/db/.wrangler/state --test-scheduled",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "postinstall": "wrangler types",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:clear:local": "wrangler d1 execute rehoboam-jobs-db --local --persist-to ../../packages/db/.wrangler/state --command \"DELETE FROM news_items;\"",
    "db:migrate:local": "wrangler d1 migrations apply rehoboam-jobs-db --local --persist-to ../../packages/db/.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply rehoboam-jobs-db --remote",
    "clean": "rm -rf .turbo node_modules .cache"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "5.9.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/prettier": "workspace:*",
    "@repo/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/service-worker-mock": "catalog:",
    "drizzle-kit": "0.31.10",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "prettier": "@repo/prettier"
}

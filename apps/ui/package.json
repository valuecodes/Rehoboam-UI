{
  "name": "rehoboam-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite preview --port 3000",
    "build": "vite build",
    "bundle:analyze": "analyze",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test --project=smoke",
    "e2e:ui": "playwright test --project=smoke --ui",
    "e2e:api": "playwright test --project=api-contract",
    "e2e:all": "playwright test --project=smoke --project=api-contract",
    "e2e:install": "playwright install --with-deps chromium",
    "screenshot:scene": "node --experimental-strip-types scripts/screenshot-scene.ts",
    "screenshot:scene:headed": "node --experimental-strip-types scripts/screenshot-scene.ts --headed",
    "clean": "rm -rf .turbo node_modules .cache dist"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@repo/types": "workspace:*",
    "motion": "12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@repo/prettier": "workspace:*",
    "@repo/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.3",
    "jsdom": "29.0.2",
    "playwright": "1.63.0",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vite-bundle-analyzer": "1.3.9",
    "vitest": "catalog:",
    "zx": "8.8.5"
  },
  "prettier": "@repo/prettier"
}

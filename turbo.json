{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // apps/api and apps/jobs also typecheck `worker-configuration.d.ts`, which
    // is gitignored and so not part of the task hash. It is generated from the
    // tracked `wrangler.jsonc` (by `postinstall` / `cf-typegen`), so hashing
    // that file is enough to keep a cached result honest.
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": true
    }
  }
}
